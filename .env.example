# ============================================================================
# BankBenchmark — root environment
# Copy to `.env` (gitignored) and fill in. This ONE file feeds both:
#   • the SERVER  (loaded via server/env.js, no matter where it's launched)
#   • the SCRIPTS (seed:rates, market:*, pool:*, import:pool, create:admin)
# The client (Vite) has its own env — see client/.env.example.
# ============================================================================

# ---- Supabase --------------------------------------------------------------
# Supabase dashboard → Project Settings → API.
#   • SERVER reads with the ANON key (RLS allows public SELECT on rate tables).
#   • SCRIPTS write with the SERVICE ROLE key (bypasses RLS).
# Keep the service-role key OFF the client and out of Vercel.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# ---- Rate data quality ------------------------------------------------------
# The rate tables mix SOURCED rows (regulator feeds / published rate sheets,
# is_indicative = false) with GENERATED ones (scripts/seed-rates.mjs, true).
# Default 'true' serves only sourced rows: an unsourced pool returns
# "No benchmark data for this selection yet." instead of a plausible invention.
# Set to false only during a data-migration window — indicative rows are then
# labelled dataQuality:'indicative' in the API response, never unmarked.
# RATES_REAL_ONLY=true

# ---- Stripe (payments — JourneyModal $99 call / $199 expert tiers) ---------
# Dashboard → Developers → API keys. Copy the SECRET key (sk_…), not pk_….
# Start with sk_test_… ; switch to sk_live_… (in prod env only) when you go live.
STRIPE_SECRET_KEY=sk_test_...
# Optional overrides (defaults shown):
# STRIPE_CURRENCY=sgd
# STRIPE_PRICE_REVEAL_CENTS=900          # $9 reveal best bank & price (standard)
# STRIPE_PRICE_REVEAL_PROMO_CENTS=100    # $1 reveal — social-share promo
# STRIPE_PRICE_CALL_CENTS=9900           # $99 coaching call
# STRIPE_PRICE_EXPERT_CENTS=19900        # $199 expert-led negotiation
# PUBLIC_BASE_URL=https://bankbenchmark.sg   # Checkout success/cancel origin (prod)

# ---- Calendly (booked-slot sync) -------------------------------------------
# Personal access token: calendly.com/app/admin/integrations/api-webhooks
# Only scripts/sync-calendly.mjs uses it — never the browser or the web server.
# Unset → bookings still record, they just show as "time syncing…" in the portal.
# CALENDLY_TOKEN=your-calendly-personal-access-token

# ---- Thailand rates (BOT) --------------------------------------------------
# Your subscribed app's Client ID (sent as the Authorization header).
BOT_API_KEY=your-bot-client-id
# BOT_API_BASE=https://gateway.api.bot.or.th

# ---- Singapore rates (MAS) — optional overrides ----------------------------
# MAS_DIR_RESOURCE=9a0bf149-308c-4bd2-832d-76c8e6cb47ed
# MAS_DATE_FIELD=end_of_period
# MAS_API_BASE=https://eservices.mas.gov.sg/api/action/datastore/search.json

# ---- Admin bootstrap (scripts/create-admin.mjs) ----------------------------
# ADMIN_EMAIL=admin@benchmark.com
# ADMIN_PASSWORD=change-me-strong

# ---- Support bootstrap (scripts/create-support.mjs) ------------------------
# The customer-support portal account (/#support). Run supabase/support.sql
# first. Generate the password, never reuse the admin one:
#   SUPPORT_PASSWORD="$(openssl rand -base64 18)" node scripts/create-support.mjs
# SUPPORT_EMAIL=usersupport@feeoptima.com
# SUPPORT_PASSWORD=change-me-strong

# ---- Server misc -----------------------------------------------------------
# PORT=3000
# FX_BASE_URL=https://api.frankfurter.dev/v1   # cross-border FX source override
# NODE_ENV=production                          # set in prod: disables dev CORS + verbose errors
# PUBLIC_BASE_URL=https://bankbenchmark.sg     # REQUIRED in prod: Stripe success/cancel base (no host-header trust)
# ALLOWED_ORIGINS=https://bankbenchmark.sg,https://www.bankbenchmark.sg  # comma-separated browser origins allowed to call the API
