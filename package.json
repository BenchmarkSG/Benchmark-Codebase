{
  "name": "bankbenchmark-sg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BankBenchmark.sg prototype — React + Express",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "seed:rates": "node scripts/seed-rates.mjs",
    "seed:rates:dry": "node scripts/seed-rates.mjs --dry",
    "market:verify": "node scripts/market-rates.mjs verify",
    "market:fetch": "node scripts/market-rates.mjs fetch",
    "pool:th": "node scripts/bot-pool.mjs",
    "pool:th:dry": "node scripts/bot-pool.mjs --dry",
    "pool:my": "node scripts/bnm-pool.mjs",
    "pool:my:dry": "node scripts/bnm-pool.mjs --dry",
    "import:pool": "node scripts/import-pool.mjs",
    "import:pool:dry": "node scripts/import-pool.mjs --dry",
    "create:admin": "node scripts/create-admin.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
