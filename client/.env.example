# Supabase — copy this file to `.env.local` and fill in your project values.
# Find these in your Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Calendly scheduling link used on Screen 3 (Book a Call / Book an Expert).
# Leave blank to show a placeholder in the booking step.
VITE_CALENDLY_URL=https://calendly.com/your-org/consultation
