# Supabase — copy this file to `.env.local` and fill in your project values.
# Find these in your Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Calendly scheduling link used on Screen 3 (Book a Call / Book an Expert).
# Use a specific event-type link, e.g. https://calendly.com/your-org/negotiation-call
# Leave blank to show a placeholder. NOTE: VITE_ vars are baked in at build time —
# rebuild/redeploy the client after changing this. (Per-advisor links are set in
# the Advisor dashboard → Profile and used automatically for the $199 expert tier.)
VITE_CALENDLY_URL=https://calendly.com/your-org/consultation

# Canonical public site URL used for shareable QR codes & share links (the
# certificate QR, "Share" buttons). Keeps them pointing at the live site instead
# of localhost or a *.vercel.app preview. Defaults to https://bankbenchmark.sg.
# VITE_ vars are baked in at build time — rebuild/redeploy after changing this.
VITE_PUBLIC_SITE_URL=https://bankbenchmark.sg

# Customer-service WhatsApp for the floating "Need Help?" widget. Digits only,
# international format, NO "+"/spaces/dashes (e.g. 6591234567 for a Singapore
# line). Opens a WhatsApp text chat (never a call). VITE_ vars are baked in at
# build time — rebuild/redeploy the client after changing this.
VITE_WHATSAPP_NUMBER=6591234567
# Optional: override the pre-filled first message.
# VITE_WHATSAPP_MESSAGE=Hi BankBenchmark team, I need help with my bank fees.

# Admin gate — the email treated as admin in the client UI (the account menu shows
# "Admin portal" and routes to #admin). Must match the admin user you create in
# Supabase (scripts/create-admin.mjs). Defaults to admin@benchmark.com if unset.
VITE_ADMIN_EMAIL=admin@benchmark.com
