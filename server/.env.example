# Server env — copy to server/.env (or export in your shell).
# The API reads rate data from Supabase using the ANON key (RLS allows public
# SELECT on the rate tables). If unset, the API falls back to local data.js.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Only needed by scripts/seed-rates.mjs to WRITE the generated data.
# This is the service_role secret — keep it private, never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Transactional email (optional). Without RESEND_API_KEY, emails are logged and
# skipped so the app still runs. Confirmation is sent automatically on a paid
# checkout; reminder/feedback are triggered via POST /api/internal/notify.
RESEND_API_KEY=re_your_key
EMAIL_FROM=FeeOptima <hello@feeoptima.com>
# Shared secret guarding /api/internal/notify (cron / Calendly webhook → reminder/feedback).
INTERNAL_TASK_KEY=a-long-random-secret

# Unlocks the booked expert's WhatsApp number on Option 3's confirmation screen,
# only after a verified expert payment. Must equal internal_keys('expert_contact')
# — see supabase/expert_contact.sql. Unset: the number is simply not shown.
EXPERT_CONTACT_KEY=a-long-random-secret-at-least-32-chars
